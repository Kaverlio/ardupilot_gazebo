<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="canvas_screen">
    <!-- модель точно НЕ статична -->
    <static>false</static>

    <link name="screen_link">
      <!-- Стартова поза -->
      <pose>0 0 1 0 0 0</pose>

      <!-- Без гравітації, щоб не падало -->
      <gravity>false</gravity>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>1</ixx>
          <iyy>1</iyy>
          <izz>1</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Колізія: тонкий бокс, щоб по ньому легко клікнути -->
      <collision name="screen_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <!-- товщина по X, ширина по Y, висота по Z -->
            <size>0.1 20 15</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
        </surface>
      </collision>

      <!-- Візуал: теж бокс, щоб плагіну було все одно -->
      <visual name="screen_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 30 15</size>
          </box>
        </geometry>

        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>

        <plugin name="canvas_plugin" filename="libCanvasPlugin.so">
          <images_dir>/home/nano/ardupilot_gazebo/images</images_dir>
          <width>1024</width>
          <height>1024</height>
          <interval>1.0</interval>
        </plugin>
      </visual>
    </link>
  </model>
</sdf>
