<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <gui>
      <camera name="user_camera">
        <pose>-5 0 1 0 0.2 0</pose>
      </camera>
    </gui>
    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>-1</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <!-- Better lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Add ambient light for better visibility -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Textured ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <!-- Detailed asphalt runway -->
        <visual name="runway">
          <pose>0 0 0.005 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Road</name>
            </script>
          </material>
        </visual>

        <!-- Textured grass with detail -->
        <visual name="grass">
          <pose>0 0 -0.1 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.3 1</ambient>
            <diffuse>0.4 0.6 0.4 1</diffuse>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/GrassFloor</name>
            </script>
          </material>
        </visual>

        <!-- Add parking area with concrete texture -->
        <visual name="parking">
          <pose>30 0 0.006 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>20 20 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Cement</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Add some visual features for better ORB tracking -->
    <!-- Helipad marking -->
    <model name="helipad">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>10 10 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.9 0.2 0.2 1</diffuse>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/RedGlow</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Add some 3D objects for visual reference -->
    <include>
      <pose>20 20 0 0 0 0</pose>
      <uri>model://gas_station</uri>
    </include>

    <include>
      <pose>-20 20 0 0 0 0</pose>
      <uri>model://house_1</uri>
    </include>

    <include>
      <pose>20 -20 0 0 0 0</pose>
      <uri>model://dumpster</uri>
    </include>

    <!-- Add trees for natural look -->
    <include>
      <pose>-10 -10 0 0 0 0</pose>
      <uri>model://oak_tree</uri>
    </include>

    <include>
      <pose>10 -10 0 0 0 0</pose>
      <uri>model://pine_tree</uri>
    </include>

    <!-- Your drone model - spawned on top of gas station -->
    <model name="iris_demo">
      <include>
        <uri>/home/wintery/Projects/gazebo/models/iris_with_ardupilot</uri>
      </include>
      <!-- Gas station is at (20, 20, 0), roof height ~4-5m -->
      <pose>20 20 5 0 0 0</pose>
    </model>
  </world>
</sdf>